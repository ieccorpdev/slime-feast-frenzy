# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:ios)

platform :ios do
  desc "Push a new release build to the App Store"
  lane :beta do
    update_sign
    update_build_number
    build_app(workspace: "Unity-iPhone.xcworkspace", scheme: "Unity-iPhone", xcargs: "-allowProvisioningUpdates", export_xcargs: "-allowProvisioningUpdates")
    upload_to_testflight
    #post_to_webhook
  end
  lane :update_sign do
    update_code_signing_settings(
      use_automatic_signing: true,
      code_sign_identity: "Apple Development",
      team_id: CredentialsManager::AppfileConfig.try_fetch_value(:team_id)
    )
  end
  lane :update_build_number do
    increment_build_number({build_number: latest_testflight_build_number + 1})
  end
  lane :local do |options|
    update_sign
    update_build_number
    build_app(workspace: "Unity-iPhone.xcworkspace", scheme: "Unity-iPhone", xcargs: "-allowProvisioningUpdates", export_xcargs: "-allowProvisioningUpdates",
        export_method: "ad-hoc", output_name: "app.ipa")
    install_on_device(device_id: options[:deviceId], ipa: "./app.ipa")
  end
end
