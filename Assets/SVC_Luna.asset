            = u_xlat5;\n                hlslcc_movcTemp.x = (u_xlatb8.x) ? u_xlat5.x
            : u_xlat6.x;\n                hlslcc_movcTemp.y = (u_xlatb8.y) ? u_xlat5.y
            : u_xlat6.y;\n                hlslcc_movcTemp.z = (u_xlatb8.z) ? u_xlat5.z
            : u_xlat6.z;\n                u_xlat5 = hlslcc_movcTemp;\n           
            }\n            u_xlat31 = min(u_xlat5.y, u_xlat5.x);\n            u_xlat31
            = min(u_xlat5.z, u_xlat31);\n            u_xlat5.xyz = vs_TEXCOORD1.xyz
            + (-unity_SpecCube1_ProbePosition.xyz);\n            u_xlat4.xyz = u_xlat4.xyz
            * vec3(u_xlat31) + u_xlat5.xyz;\n        } else {\n            u_xlat4.xyz
            = u_xlat16_2.xyz;\n        }\n        u_xlat10_4 = textureCubeLodEXT(unity_SpecCube1,
            u_xlat4.xyz, 6.0);\n        u_xlat16_2.x = u_xlat10_4.w + -1.0;\n       
            u_xlat16_2.x = unity_SpecCube1_HDR.w * u_xlat16_2.x + 1.0;\n        u_xlat16_2.x
            = u_xlat16_2.x * unity_SpecCube1_HDR.x;\n        u_xlat16_2.xyz = u_xlat10_4.xyz
            * u_xlat16_2.xxx;\n        u_xlat3.xyz = vec3(u_xlat16_32) * u_xlat10_3.xyz
            + (-u_xlat16_2.xyz);\n        u_xlat7.xyz = unity_SpecCube0_BoxMin.www
            * u_xlat3.xyz + u_xlat16_2.xyz;\n        u_xlat16_7.xyz = u_xlat7.xyz;\n   
            }\n    u_xlat31 = dot(vs_TEXCOORD0.xyz, vs_TEXCOORD0.xyz);\n    u_xlat31
            = inversesqrt(u_xlat31);\n    u_xlat3.xyz = vec3(u_xlat31) * vs_TEXCOORD0.xyz;\n   
            u_xlat16_2.xyz = _Color.xyz * vec3(0.779083729, 0.779083729, 0.779083729);\n   
            u_xlat0.xyz = u_xlat0.xyz * vec3(u_xlat30) + _WorldSpaceLightPos0.xyz;\n   
            u_xlat30 = dot(u_xlat0.xyz, u_xlat0.xyz);\n    u_xlat30 = max(u_xlat30,
