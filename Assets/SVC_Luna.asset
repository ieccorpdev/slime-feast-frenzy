            = u_xlat16_6 * -2.0 + 3.0;\n    u_xlat16_6 = u_xlat16_6 * u_xlat16_6;\n   
            u_xlat16_6 = u_xlat16_6 * u_xlat16_11;\n    u_xlat16_3.xyz = vec3(u_xlat16_6)
