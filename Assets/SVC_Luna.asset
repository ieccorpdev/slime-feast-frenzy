            = vec3(u_xlat30) * u_xlat0.xyz;\n    u_xlat30 = dot(u_xlat3.xyz, u_xlat1.xyz);\n   
            u_xlat1.x = dot(u_xlat3.xyz, _WorldSpaceLightPos0.xyz);\n    u_xlat1.x
            = clamp(u_xlat1.x, 0.0, 1.0);\n    u_xlat0.x = dot(_WorldSpaceLightPos0.xyz,
            u_xlat0.xyz);\n    u_xlat0.x = clamp(u_xlat0.x, 0.0, 1.0);\n    u_xlat16_32
            = u_xlat0.x + u_xlat0.x;\n    u_xlat16_32 = u_xlat16_32 * u_xlat0.x +
