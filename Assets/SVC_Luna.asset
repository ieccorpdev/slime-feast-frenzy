            * u_xlat12;\n    u_xlat3.x = max(u_xlat3.x, 0.00200000009);\n    u_xlat9
            = u_xlat3.x * u_xlat3.x;\n    u_xlat15 = u_xlat21 * u_xlat9 + (-u_xlat21);\n   
