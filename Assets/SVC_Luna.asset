            = vec3(vec3(_ColorRampBlend, _ColorRampBlend, _ColorRampBlend)) * u_xlat16_5.xyz
            + u_xlat16_7.xyz;\n    u_xlat16_3.x = float(1.0) / _PosterizeNumColors;\n   
            u_xlat16_7.xyz = u_xlat16_7.xyz / u_xlat16_3.xxx;\n    u_xlat16_7.xyz
            = floor(u_xlat16_7.xyz);\n    u_xlat16_7.xyz = u_xlat16_3.xxx * u_xlat16_7.xyz;\n   
            SV_Target0.xyz = u_xlat16_0.xxx * u_xlat16_7.xyz;\n    SV_Target0.w =
            u_xlat16_0.x;\n    return;\n}\n\n"
