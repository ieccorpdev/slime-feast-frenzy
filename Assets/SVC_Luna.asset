            1.0);\n    u_xlat16_13 = (-u_xlat16_13) + 1.0;\n    u_xlat16_13 = sqrt(u_xlat16_13);\n   
            u_xlat16_2.xyz = u_xlat16_1.yyy * vs_TEXCOORD3.xyz;\n    u_xlat16_1.xyw
            = vs_TEXCOORD2.xyz * u_xlat16_1.xxx + u_xlat16_2.xyz;\n    u_xlat16_1.xyz
            = vs_TEXCOORD4.xyz * vec3(u_xlat16_13) + u_xlat16_1.xyw;\n    u_xlat0.x
            = dot(u_xlat16_1.xyz, u_xlat16_1.xyz);\n    u_xlat0.x = inversesqrt(u_xlat0.x);\n   
            u_xlat0.xyz = u_xlat0.xxx * u_xlat16_1.xyz;\n    u_xlat18 = dot(vs_TEXCOORD1.xyz,
