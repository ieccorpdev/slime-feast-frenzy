            u_xlat16_2.x = (-u_xlat6) + 1.0;\n    u_xlat16_8.x = u_xlat16_2.x * u_xlat16_2.x;\n   
            u_xlat16_8.x = u_xlat16_8.x * u_xlat16_8.x;\n    u_xlat16_2.x = u_xlat16_2.x
