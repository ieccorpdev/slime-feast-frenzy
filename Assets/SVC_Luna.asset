            u_xlat6.x = dot(u_xlat16_5.yx, u_xlat15.xy);\n    u_xlat15.xy = u_xlat16_7.xy
            + u_xlat6.xy;\n    u_xlat11.xy = u_xlat4.xx * vec2(_Shape2XSpeed, _Shape2YSpeed);\n   
            u_xlat4.xw = u_xlat4.xx * vec2(_ShapeXSpeed, _ShapeYSpeed);\n    u_xlatb6.xy
            = greaterThanEqual(u_xlat11.xyxx, (-u_xlat11.xyxx)).xy;\n    u_xlat6.x
            = (u_xlatb6.x) ? float(1.0) : float(-1.0);\n    u_xlat6.y = (u_xlatb6.y)
            ? float(1.0) : float(-1.0);\n    u_xlat11.xy = u_xlat11.xy * u_xlat6.xy;\n   
            u_xlat11.xy = fract(u_xlat11.xy);\n    u_xlat15.xy = u_xlat6.xy * u_xlat11.xy
            + u_xlat15.xy;\n    u_xlat16_2 = texture(_Shape2Tex, u_xlat15.xy);\n   
            u_xlat16_7.x = u_xlat16_2.w * _Shape2Color.w;\n    u_xlat16_3.xyz = u_xlat16_2.xyz
            * _Shape2Color.xyz + vec3(-0.5, -0.5, -0.5);\n    u_xlat16_3.xyz = u_xlat16_3.xyz
            * vec3(_Shape2Contrast) + vec3(vec3(_Shape2Brightness, _Shape2Brightness,
            _Shape2Brightness));\n    u_xlat16_3.xyz = u_xlat16_3.xyz + vec3(0.5,
            0.5, 0.5);\n    u_xlat16_3.xyz = max(u_xlat16_3.xyz, vec3(0.0, 0.0, 0.0));\n   
            u_xlat16_3.xyz = u_xlat16_3.xyz * vec3(vec3(_Shape2ColorWeight, _Shape2ColorWeight,
            _Shape2ColorWeight));\n    u_xlat16_7.x = u_xlat16_7.x * _Shape2AlphaWeight;\n   
            u_xlatb15.xy = greaterThanEqual(u_xlat4.xwxw, (-u_xlat4.xwxw)).xy;\n   
            u_xlat15.x = (u_xlatb15.x) ? float(1.0) : float(-1.0);\n    u_xlat15.y
            = (u_xlatb15.y) ? float(1.0) : float(-1.0);\n    u_xlat4.xy = u_xlat15.xy
            * u_xlat4.xw;\n    u_xlat4.xy = fract(u_xlat4.xy);\n    u_xlat1.xy =
            u_xlat15.xy * u_xlat4.xy + u_xlat1.xy;\n    u_xlat16_1 = texture(_MainTex,
            u_xlat1.xy);\n    u_xlat16_14 = u_xlat16_1.w * _ShapeColor.w;\n    u_xlat16_5.xyz
            = u_xlat16_1.xyz * _ShapeColor.xyz + vec3(-0.5, -0.5, -0.5);\n    u_xlat16_5.xyz
            = u_xlat16_5.xyz * vec3(_ShapeContrast) + vec3(vec3(_ShapeBrightness,
            _ShapeBrightness, _ShapeBrightness));\n    u_xlat16_5.xyz = u_xlat16_5.xyz
            + vec3(0.5, 0.5, 0.5);\n    u_xlat16_5.xyz = max(u_xlat16_5.xyz, vec3(0.0,
            0.0, 0.0));\n    u_xlat16_5.xyz = u_xlat16_5.xyz * vec3(vec3(_ShapeColorWeight,
            _ShapeColorWeight, _ShapeColorWeight));\n    u_xlat16_3.xyz = u_xlat16_3.xyz
            * u_xlat16_5.xyz;\n    u_xlat16_14 = u_xlat16_14 * _ShapeAlphaWeight;\n   
            u_xlat16_7.x = u_xlat16_7.x * u_xlat16_14;\n    u_xlat16_7.x = clamp(u_xlat16_7.x,
            0.0, 1.0);\n    u_xlat16_14 = dot(u_xlat16_3.xyz, vec3(0.300000012, 0.589999974,
            0.109999999));\n    u_xlat16_7.x = min(u_xlat16_7.x, u_xlat16_14);\n   
            u_xlat16_5.x = u_xlat16_14 + _ColorRampLuminosity;\n    u_xlat16_5.x
            = clamp(u_xlat16_5.x, 0.0, 1.0);\n    u_xlat16_5.y = 0.0;\n    u_xlat16_1
            = texture(_ColorRampTexGradient, u_xlat16_5.xy);\n    u_xlat16_14 = u_xlat16_7.x
            * u_xlat16_1.w;\n    u_xlat16_14 = clamp(u_xlat16_14, 0.0, 1.0);\n   
            u_xlat16_14 = (-u_xlat16_7.x) + u_xlat16_14;\n    u_xlat16_7.x = _ColorRampBlend
            * u_xlat16_14 + u_xlat16_7.x;\n    u_xlat16_0.x = u_xlat16_0.x * u_xlat16_7.x;\n   
