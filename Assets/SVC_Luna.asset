      - Shader: {fileID: 4800000, guid: da68c447cdb010644b543594f5982aa4, type: 3}
        ShaderVariants:
        - ShaderCompilerPlatform: 5
          NoShaderVariant: 0
          VertexProgram: "\n#version 100\n\nuniform \tvec4 _Time;\nuniform \tvec4
            _ProjectionParams;\nuniform \tvec4 hlslcc_mtx4x4unity_ObjectToWorld[4];\nuniform
            \tvec4 hlslcc_mtx4x4unity_MatrixVP[4];\nuniform \tfloat _Wave1Direction;\nuniform
            \tfloat _Wave1Amplitude;\nuniform \tfloat _Wave1Wavelength;\nuniform
            \tfloat _Wave1Speed;\nuniform \tfloat _Wave2Direction;\nuniform \tfloat
            _Wave2Amplitude;\nuniform \tfloat _Wave2Wavelength;\nuniform \tfloat
            _Wave2Speed;\nattribute highp vec4 in_POSITION0;\nattribute highp vec2
            in_TEXCOORD0;\nvarying highp vec4 vs_TEXCOORD3;\nvarying highp vec2 vs_TEXCOORD0;\nvarying
            highp vec3 vs_TEXCOORD1;\nvarying highp vec4 vs_TEXCOORD2;\nvec4 u_xlat0;\nvec4
            u_xlat1;\nfloat u_xlat2;\nvec2 u_xlat3;\nfloat u_xlat5;\nvoid main()\n{\n   
            u_xlat0.x = _Wave2Direction * 3.14159274;\n    u_xlat1.x = cos(u_xlat0.x);\n   
            u_xlat0.x = sin(u_xlat0.x);\n    u_xlat1.y = u_xlat0.x;\n    u_xlat0.xyz
            = in_POSITION0.yyy * hlslcc_mtx4x4unity_ObjectToWorld[1].xyz;\n    u_xlat0.xyz
            = hlslcc_mtx4x4unity_ObjectToWorld[0].xyz * in_POSITION0.xxx + u_xlat0.xyz;\n   
            u_xlat0.xyz = hlslcc_mtx4x4unity_ObjectToWorld[2].xyz * in_POSITION0.zzz
            + u_xlat0.xyz;\n    u_xlat0.xyz = hlslcc_mtx4x4unity_ObjectToWorld[3].xyz
            * in_POSITION0.www + u_xlat0.xyz;\n    u_xlat1.x = dot(u_xlat0.xz, u_xlat1.xy);\n   
            u_xlat1.x = u_xlat1.x * 3.14159274;\n    u_xlat1.x = u_xlat1.x / _Wave2Wavelength;\n   
            u_xlat1.x = _Wave2Speed * _Time.y + u_xlat1.x;\n    u_xlat1.x = sin(u_xlat1.x);\n   
            u_xlat1.x = u_xlat1.x * _Wave2Amplitude;\n    u_xlat5 = _Wave1Direction
            * 3.14159274;\n    u_xlat2 = sin(u_xlat5);\n    u_xlat3.x = cos(u_xlat5);\n   
            u_xlat3.y = u_xlat2;\n    u_xlat5 = dot(u_xlat0.xz, u_xlat3.xy);\n   
            u_xlat5 = u_xlat5 * 3.14159274;\n    u_xlat5 = u_xlat5 / _Wave1Wavelength;\n   
            u_xlat5 = _Wave1Speed * _Time.y + u_xlat5;\n    u_xlat5 = sin(u_xlat5);\n   
            u_xlat1.x = _Wave1Amplitude * u_xlat5 + u_xlat1.x;\n    u_xlat0.w = u_xlat0.y
            + u_xlat1.x;\n    u_xlat1 = u_xlat0.wwww * hlslcc_mtx4x4unity_MatrixVP[1];\n   
            vs_TEXCOORD1.xyz = u_xlat0.xwz;\n    u_xlat1 = hlslcc_mtx4x4unity_MatrixVP[0]
            * u_xlat0.xxxx + u_xlat1;\n    u_xlat0 = hlslcc_mtx4x4unity_MatrixVP[2]
            * u_xlat0.zzzz + u_xlat1;\n    u_xlat0 = u_xlat0 + hlslcc_mtx4x4unity_MatrixVP[3];\n   
            u_xlat1.xyz = u_xlat0.xyw * vec3(0.5, 0.5, 0.5);\n    u_xlat1.w = u_xlat1.y
            * _ProjectionParams.x;\n    vs_TEXCOORD3.xy = u_xlat1.zz + u_xlat1.xw;\n   
            vs_TEXCOORD2.xy = u_xlat1.zz + u_xlat1.xy;\n    gl_Position = u_xlat0;\n   
            vs_TEXCOORD3.zw = u_xlat0.zw;\n    vs_TEXCOORD2.zw = u_xlat0.zw;\n   
            vs_TEXCOORD0.xy = in_TEXCOORD0.xy;\n    return;\n}\n\n"
          FragmentProgram: "\n#version 100\n\n#ifdef GL_FRAGMENT_PRECISION_HIGH\n   
            precision highp float;\n#else\n    precision mediump float;\n#endif\nprecision
            highp int;\nuniform \tvec4 _Time;\nuniform \tvec3 _WorldSpaceCameraPos;\nuniform
            \tvec4 _ZBufferParams;\nuniform \tvec4 _WorldSpaceLightPos0;\nuniform
            \tfloat _DepthDensity;\nuniform \tfloat _ScreenYThreshold;\nuniform \tfloat
            _ScreenYCurve;\nuniform \tfloat _FarAlpha;\nuniform \tint _EaseType;\nuniform
            \tfloat _WaveNormalScale;\nuniform \tfloat _WaveNormalSpeed;\nuniform
            \tfloat _ScreenYThresholdBottom;\nuniform \tfloat _ScreenYCurveBottom;\nuniform
            \tint _EaseTypeBottom;\nuniform \tvec3 _NearColor;\nuniform \tfloat _NearAlpha;\nuniform
            \tvec3 _ShallowColor;\nuniform \tvec3 _DeepColor;\nuniform \tvec3 _FarColor;\nuniform
            \tfloat _ReflectionContribution;\nuniform \tvec3 _SSSColor;\nuniform
            \tfloat _FoamScale;\nuniform \tfloat _FoamNoiseScale;\nuniform \tfloat
            _FoamSpeed;\nuniform \tfloat _FoamContribution;\nuniform \tvec3 _SunSpecularColor;\nuniform
            \tfloat _SunSpecularExponent;\nuniform \tfloat _SparkleScale;\nuniform
            \tfloat _SparkleSpeed;\nuniform \tfloat _SparkleExponent;\nuniform \tvec3
            _SparkleColor;\nuniform \tvec3 _EdgeFoamColor;\nuniform \tfloat _EdgeFoamDepth;\nuniform
            \tfloat _Wave1Direction;\nuniform \tfloat _Wave1Amplitude;\nuniform \tfloat
            _Wave1Wavelength;\nuniform \tfloat _Wave1Speed;\nuniform \tfloat _Wave2Direction;\nuniform
            \tfloat _Wave2Amplitude;\nuniform \tfloat _Wave2Wavelength;\nuniform
            \tfloat _Wave2Speed;\nuniform lowp sampler2D _WaveNormalMap;\nuniform
            lowp sampler2D _GrabTexture;\nuniform highp sampler2D _CameraDepthTexture;\nuniform
            lowp sampler2D _FoamTexture;\nuniform lowp sampler2D _SparklesNormalMap;\nuniform
            lowp samplerCube unity_SpecCube0;\nvarying highp vec4 vs_TEXCOORD3;\nvarying
            highp vec3 vs_TEXCOORD1;\nvarying highp vec4 vs_TEXCOORD2;\n#define SV_Target0
            gl_FragData[0]\nvec4 u_xlat0;\nvec4 u_xlat1;\nlowp vec3 u_xlat10_1;\nvec4
            u_xlat2;\nvec4 u_xlat3;\nlowp vec4 u_xlat10_3;\nbool u_xlatb3;\nvec4
            u_xlat4;\nlowp vec3 u_xlat10_4;\nvec4 u_xlat5;\nlowp vec3 u_xlat10_5;\nmediump
            vec3 u_xlat16_6;\nmediump vec3 u_xlat16_7;\nmediump vec3 u_xlat16_8;\nmediump
            vec3 u_xlat16_9;\nfloat u_xlat10;\nvec3 u_xlat11;\nlowp vec3 u_xlat10_11;\nfloat
            u_xlat12;\nlowp float u_xlat10_12;\nmediump float u_xlat16_16;\nfloat
            u_xlat20;\nfloat u_xlat21;\nlowp float u_xlat10_21;\nfloat u_xlat22;\nlowp
            float u_xlat10_22;\nfloat u_xlat23;\nvec2 u_xlat24;\nlowp vec2 u_xlat10_24;\nlowp
            vec2 u_xlat10_25;\nfloat u_xlat30;\nfloat u_xlat31;\nfloat u_xlat32;\nmediump
            float u_xlat16_36;\nfloat unity_roundEven(float x) { float y = floor(x
            + 0.5); return (y - x == 0.5) ? floor(0.5*y) * 2.0 : y; }\nvec2 unity_roundEven(vec2
            a) { a.x = unity_roundEven(a.x); a.y = unity_roundEven(a.y); return a;
            }\nvec3 unity_roundEven(vec3 a) { a.x = unity_roundEven(a.x); a.y = unity_roundEven(a.y);
            a.z = unity_roundEven(a.z); return a; }\nvec4 unity_roundEven(vec4 a)
            { a.x = unity_roundEven(a.x); a.y = unity_roundEven(a.y); a.z = unity_roundEven(a.z);
            a.w = unity_roundEven(a.w); return a; }\n\nvoid main()\n{\nvec4 hlslcc_FragCoord
            = vec4(gl_FragCoord.xyz, 1.0/gl_FragCoord.w);\n    u_xlat0.x = _Wave2Direction
            * 3.14159274;\n    u_xlat1.x = cos(u_xlat0.x);\n    u_xlat0.x = sin(u_xlat0.x);\n   
            u_xlat1.y = u_xlat0.x;\n    u_xlat0 = vs_TEXCOORD1.xzxz + vec4(-0.00999999978,
            -0.0, -0.0, -0.00999999978);\n    u_xlat21 = dot(u_xlat0.zw, u_xlat1.xy);\n   
            u_xlat21 = u_xlat21 * 3.14159274;\n    u_xlat21 = u_xlat21 / _Wave2Wavelength;\n   
            u_xlat21 = _Wave2Speed * _Time.y + u_xlat21;\n    u_xlat21 = sin(u_xlat21);\n   
            u_xlat21 = u_xlat21 * _Wave2Amplitude;\n    u_xlat31 = _Wave1Direction
            * 3.14159274;\n    u_xlat2.x = sin(u_xlat31);\n    u_xlat3.x = cos(u_xlat31);\n   
            u_xlat3.y = u_xlat2.x;\n    u_xlat20 = dot(u_xlat0.zw, u_xlat3.xy);\n   
            u_xlat20 = u_xlat20 * 3.14159274;\n    u_xlat20 = u_xlat20 / _Wave1Wavelength;\n   
            u_xlat20 = _Wave1Speed * _Time.y + u_xlat20;\n    u_xlat20 = sin(u_xlat20);\n   
            u_xlat20 = _Wave1Amplitude * u_xlat20 + u_xlat21;\n    u_xlat0.w = dot(vs_TEXCOORD1.xz,
            u_xlat1.xy);\n    u_xlat1.x = dot(u_xlat0.xy, u_xlat1.xy);\n    u_xlat0.x
