            * u_xlat16_42;\n    u_xlat16_35 = u_xlat16_35 * 0.779083729 + 0.220916301;\n   
            u_xlat0.xyz = u_xlat11.xyz * vec3(u_xlat16_35);\n    u_xlat0.xyz = u_xlat16_2.xyz
            * u_xlat16_21.xyz + u_xlat0.xyz;\n    u_xlat16_2.xyz = u_xlat16_9.xyz
