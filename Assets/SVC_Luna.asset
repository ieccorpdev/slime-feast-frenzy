            = unity_SpecCube0_HDR.w * u_xlat16_36 + 1.0;\n    u_xlat16_36 = u_xlat16_36
            * unity_SpecCube0_HDR.x;\n    u_xlat16_8.xyz = u_xlat10_4.xyz * vec3(u_xlat16_36);\n   
            u_xlatb34 = unity_SpecCube0_BoxMin.w<0.999989986;\n    if(u_xlatb34){\n       
