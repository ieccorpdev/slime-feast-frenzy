            main()\n{\n    u_xlat10_0.xy = texture2D(_BumpMap, vs_TEXCOORD0.xy).yw;\n   
            u_xlat16_1.xy = u_xlat10_0.yx * vec2(2.0, 2.0) + vec2(-1.0, -1.0);\n   
