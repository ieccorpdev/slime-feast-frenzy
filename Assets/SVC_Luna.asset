            u_xlat16_2.xyz;\n            u_xlat5.xyz = (-vs_TEXCOORD1.xyz) + unity_SpecCube1_BoxMax.xyz;\n           
            u_xlat5.xyz = u_xlat5.xyz / u_xlat4.xyz;\n            u_xlat6.xyz = (-vs_TEXCOORD1.xyz)
