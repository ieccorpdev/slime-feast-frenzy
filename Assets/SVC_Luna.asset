            = u_xlat16_2.xyz * _RimColor.xyz;\n    u_xlat10_0 = texture2D(_BaseMap,
            vs_TEXCOORD1.xy);\n    u_xlat16_4.xyz = u_xlat10_0.xyz * _BaseColor.xyz;\n   
            SV_Target0.w = u_xlat10_0.w * _BaseColor.w;\n    SV_Target0.xyz = u_xlat16_4.xyz
            * u_xlat16_3.xyz + u_xlat16_2.xyz;\n    return;\n}\n\n"
