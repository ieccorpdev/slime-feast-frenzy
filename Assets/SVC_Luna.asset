            = dot(u_xlat2.xyz, u_xlat0.xyz);\n    u_xlat16_6 = u_xlat0.x * 0.5 +
            0.5;\n    u_xlat16_11 = (-_RampSmoothing) * 0.5 + _RampThreshold;\n   
            u_xlat16_6 = (-u_xlat16_11) + u_xlat16_6;\n    u_xlat16_16 = _RampSmoothing
            * 0.5 + _RampThreshold;\n    u_xlat16_11 = (-u_xlat16_11) + u_xlat16_16;\n   
