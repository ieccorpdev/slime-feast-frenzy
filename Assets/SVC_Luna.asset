            = u_xlat16_3.x * unity_SpecCube1_HDR.x;\n        u_xlat16_3.xyz = u_xlat10_5.xyz
            * u_xlat16_3.xxx;\n        u_xlat4.xyz = vec3(u_xlat16_36) * u_xlat10_4.xyz
